---
/**
 * The splash-page hero, styled like the perms.io hero: drifting brand-colour glows, a pill
 * badge, a headline that may contain <span class="text-gradient"> and gradient / outline buttons.
 * Frontmatter: hero.title, hero.tagline, hero.actions (variant "primary" or "secondary"), and an
 * optional `heroBadge` string.
 */
import { Icon } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const badge = data.heroBadge;
// Starlight's page-title id, so the "skip to content" link and TOC still find the heading.
const PAGE_TITLE_ID = '_top';
---

<div class="hero">
	<div class="glow glow-teal" aria-hidden="true"></div>
	<div class="glow glow-purple" aria-hidden="true"></div>

	{badge && <p class="badge"><span class="badge-new">New</span>{badge}</p>}
	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ link, text, variant, icon }) => (
					<a class:list={['hero-btn', variant === 'primary' ? 'hero-btn-primary' : 'hero-btn-secondary']} href={link}>
						{text}
						{icon?.name && <Icon name={icon.name as any} size="1.1rem" />}
					</a>
				))}
			</div>
		)
	}
</div>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		padding-block: 3.5rem 2.5rem;
	}

	.glow {
		position: absolute;
		z-index: -1;
		width: 26rem;
		height: 26rem;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.35;
		animation: blob-float 8s ease-in-out infinite;
		pointer-events: none;
	}
	.glow-teal {
		background: var(--permio-teal);
		top: -6rem;
		left: -8rem;
	}
	.glow-purple {
		background: var(--permio-purple);
		bottom: -8rem;
		right: -8rem;
		animation-delay: 2s;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.3rem 0.9rem 0.3rem 0.35rem;
		border: 1px solid rgb(20 184 166 / 0.35);
		border-radius: 999px;
		background: rgb(17 24 39 / 0.6);
		backdrop-filter: blur(6px);
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
	.badge-new {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: rgb(112 59 237 / 0.35);
		color: #e9ddff;
		font-weight: 700;
		font-size: 0.75rem;
	}

	h1 {
		margin: 0;
		max-width: 20ch;
		font-size: clamp(2.4rem, 6vw, 3.75rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}

	.tagline {
		margin: 0;
		max-width: 38rem;
		font-size: clamp(1.05rem, 2.2vw, 1.25rem);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}
	.hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 3.25rem;
		padding: 0 1.75rem;
		border-radius: 1rem;
		font-size: 1.05rem;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.3s ease;
	}
	.hero-btn-primary {
		color: #fff;
		background: var(--permio-gradient-cta);
		background-size: 200% 100%;
	}
	.hero-btn-primary:hover {
		background-position: 100% 0;
		transform: translateY(-2px);
		box-shadow: 0 10px 15px -3px rgb(20 184 166 / 0.25);
	}
	.hero-btn-secondary {
		color: #fff;
		border: 1px solid #4b5563;
		backdrop-filter: blur(4px);
	}
	.hero-btn-secondary:hover {
		border-color: rgb(20 184 166 / 0.5);
		background: rgb(31 41 55 / 0.5);
		transform: translateY(-2px);
	}

	@keyframes blob-float {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(10px, -10px) scale(1.05);
		}
		66% {
			transform: translate(-5px, 5px) scale(0.95);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.glow {
			animation: none;
		}
	}
</style>
